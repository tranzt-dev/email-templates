<mjml>
  <mj-include path="../components/head.mjml" />

  <mj-body css-class="main">
    <mj-include path="../components/logo.mjml" />

    <mj-section
      mj-class="body-section"
      background-color="#FFF"
      border-radius="12px"
    >
      <mj-column width="100%">
        <mj-text
          font-family="Inter"
          font-size="20px"
          line-height="140%"
          font-weight="700"
          padding-bottom="30px"
        >
          Verify Your Email
        </mj-text>

        <mj-text padding-bottom="8px"> Hi {{firstName}}, </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          Welcome to Tranzt! Please use the verification code below to confirm
          your email address.
        </mj-text>

        <mj-text
          font-size="32px"
          font-weight="700"
          color="#000"
          letter-spacing="8px"
          align="center"
          padding-top="16px"
          padding-bottom="16px"
          background-color="#F5F7FA"
          border-radius="8px"
        >
          {{verification_code}}
        </mj-text>

        <mj-text
          font-size="14px"
          color="#384860"
          padding-top="16px"
          padding-bottom="8px"
        >
          This code expires in <strong>{{expiration_time}} minutes</strong>.
        </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          If you didn't create an account with Tranzt, you can safely ignore
          this email.
        </mj-text>
      </mj-column>

      <mj-column width="100%" padding-top="24px">
        <mj-text
          color="#384860"
          line-height="150%"
          font-size="14px"
          font-weight="400"
        >
          Tranzt Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
