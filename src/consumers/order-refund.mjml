<mjml>
  <mj-include path="../components/head.mjml" />

  <mj-body css-class="main">
    <mj-include path="../components/logo.mjml" />

    <mj-section
      mj-class="body-section"
      background-color="#FFF"
      border-radius="12px"
    >
      <mj-column width="100%">
        <mj-text
          font-family="Inter"
          font-size="20px"
          line-height="140%"
          font-weight="700"
          padding-bottom="30px"
        >
          Order Refund Processed
        </mj-text>

        <mj-text padding-bottom="8px"> Hi {{firstName}}, </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          Your refund for Order #{{order_number}} has been processed
          successfully.
        </mj-text>

        <mj-text font-size="14px" color="#384860"> Refund Details: </mj-text>

        <mj-list padding-left="12px">
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Order Number: #{{order_number}}
          </mj-li>
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Refund Amount: ₦{{refund_amount}}
          </mj-li>
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Reason: {{refund_reason}}
          </mj-li>
        </mj-list>

        <mj-text
          font-size="14px"
          color="#384860"
          padding-top="16px"
          padding-bottom="8px"
        >
          The refund should reflect in your account within 3–5 business days. If
          you have any questions, feel free to contact our support team.
        </mj-text>
      </mj-column>

      <mj-column width="100%" padding-top="24px">
        <mj-text
          color="#384860"
          line-height="150%"
          font-size="14px"
          font-weight="400"
        >
          Tranzt Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
