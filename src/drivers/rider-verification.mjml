<mjml>
  <mj-include path="../components/head.mjml" />

  <mj-body css-class="main">
    <mj-include path="../components/logo.mjml" />

    <mj-section
      mj-class="body-section"
      background-color="#FFF"
      border-radius="12px"
    >
      <mj-column width="100%">
        <mj-text
          font-family="Inter"
          font-size="20px"
          line-height="140%"
          font-weight="700"
          padding-bottom="30px"
        >
          You're Verified! ✅
        </mj-text>

        <mj-text padding-bottom="8px"> Hi {{firstName}}, </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          Congratulations! Your rider account has been verified and approved.
          You can now start accepting delivery requests on Tranzt.
        </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          Here's how to get started:
        </mj-text>

        <mj-list padding-left="12px">
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Open the Tranzt Rider app
          </mj-li>
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Go online to start receiving delivery requests
          </mj-li>
          <mj-li
            color="#384860"
            line-height="150%"
            font-size="14px"
            font-weight="400"
          >
            Accept orders and earn!
          </mj-li>
        </mj-list>
      </mj-column>

      <mj-column width="100%" padding-top="24px">
        <mj-text
          padding-top="24px"
          color="#384860"
          line-height="150%"
          font-size="14px"
          font-weight="400"
        >
          Welcome aboard — we're excited to have you on the team!
        </mj-text>

        <mj-text
          padding-top="16px"
          color="#384860"
          line-height="150%"
          font-size="14px"
          font-weight="400"
        >
          Tranzt Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
