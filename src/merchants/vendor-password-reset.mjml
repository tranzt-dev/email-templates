<mjml>
  <mj-include path="../components/head.mjml" />

  <mj-body css-class="main">
    <mj-include path="../components/logo.mjml" />

    <mj-section
      mj-class="body-section"
      background-color="#FFF"
      border-radius="12px"
    >
      <mj-column width="100%">
        <mj-text
          font-family="Inter"
          font-size="20px"
          line-height="140%"
          font-weight="700"
          padding-bottom="30px"
        >
          Password Reset
        </mj-text>

        <mj-text padding-bottom="8px"> Hi {{vendorName}}, </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          Your password has been reset by an administrator. Please use the
          temporary credentials below to log in.
        </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="4px" padding-top="12px"
          container-background-color="#F5F7FA">
          <strong>Email:</strong> {{vendorEmail}}
        </mj-text>
        <mj-text font-size="14px" color="#384860" padding-bottom="12px"
          container-background-color="#F5F7FA">
          <strong>Temporary Password:</strong> {{temporaryPassword}}
        </mj-text>

        <mj-text
          font-size="14px"
          color="#384860"
          padding-top="16px"
          padding-bottom="8px"
        >
          For your security, please change your password immediately after
          logging in.
        </mj-text>

        <mj-text font-size="14px" color="#384860" padding-bottom="8px">
          If you did not request this reset, please contact our support team
          immediately.
        </mj-text>
      </mj-column>

      <mj-column width="100%" padding-top="24px">
        <mj-text
          color="#384860"
          line-height="150%"
          font-size="14px"
          font-weight="400"
        >
          Tranzt Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
